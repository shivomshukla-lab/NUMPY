#Coin Flip Probability: Simulate thousands of coin flips to verify the law of large numbers (the closer you get to infinity, the closer the result gets to 50/50).

import numpy as np
import matplotlib.pyplot as plt

coin_flips = np.random.randint(1,3,10000)
print(coin_flips)
elements , counts = np.unique(coin_flips , return_counts = True)
print(elements)
print(counts)

plt.bar(['Heads','Tails'] , counts)
plt.show()
